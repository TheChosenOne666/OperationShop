# 环境与本地配置
.env
.local/

# 生成物
outputs/

# 引擎工程缓存（Cocos Creator 3.8.8）
# NewProject/.gitignore 里已有声明，这里在仓库根再兜一层，避免误提交缓存
NewProject/library/
NewProject/temp/
NewProject/local/
NewProject/build/
NewProject/profiles/

# 智能体工作目录：本地运行状态，不入库
# 项目知识已沉淀在 docs/ 与 design/ 中，无需重复入库
.workbuddy/
.workbuddy-ai/

# 仓库根的 agent 规则文件（按本机环境维护，不进版本库）
/AGENTS.md

# Qoder 技能在本机的报告产物（会话 token / credits 消耗的 Canvas 快照），不入库
.qoder-credits/

# 模块任务的中间产物（切片、临时脚本输出），不入库
# 最终素材落在 assets/，可复现的管线脚本如需留存应移到 tools/
.work/

# 图像生成工具在本机的落盘目录（候选原图已转存到 .work/incoming/），不入库
vibe_images/

# tools/ 下脚本互相 import 时产生的字节码缓存，不入库
__pycache__/

# 微信开发者工具在仓库根落下的工程标记文件（IDE 本地状态，非项目源码）。
# 注：真正的工程配置在构建产物 NewProject/build/wechatgame/project.config.json 里，由构建生成。
/project.config.json
/project.private.config.json

# 客户端构建期注入的本地后端地址与开发令牌——含机密，且每次构建重写。
# .meta 一并忽略：脚本按路径 import、不按 uuid 引用，没有跨端一致性问题，忽略可免每次构建脏一次。
NewProject/assets/scripts/BuildConfig.ts
NewProject/assets/scripts/BuildConfig.ts.meta
